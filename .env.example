# MLflow tracking server. Optional: decoding sweeps and encoding runs with
# `trainer.logging=false` run without it. When set, it is read by
# src/ntt_downstream/encoding/train.py and configs/encoding/trainer/default.yaml
# via ${oc.env:MLFLOW_TRACKING_URI}.
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# --- Optional: SLURM submission via scripts/decoding/submit.sh ---
# Site-specific values that the #SBATCH block cannot read from the
# environment. The wrapper injects them as `sbatch` CLI flags, overriding the
# generic `gpu` partition fallback in the scripts. Leave blank to keep the
# in-file default.
PARTITION=
GRES=
# Extra sbatch flags forwarded verbatim, e.g. "--time=4:00:00 --mem=64G".
SBATCH_EXTRA=

# Brainsets processed-data root for decoding runs. The decoding sbatch
# scripts forward this as --data-root; without it train.py falls back to
# ./data/processed/, which only exists if you put the data there.
DATA_ROOT=
